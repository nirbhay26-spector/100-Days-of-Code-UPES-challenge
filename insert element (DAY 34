
// Q67: Insert an element in an array at a given position.


#include <stdio.h>

int main() {
    int n, pos, val;

    // Read size of array
    if (scanf("%d", &n) != 1) return 0;

    int arr[100]; // Assuming maximum array size

    // Read array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Read target position (0-based index) and value to insert
    scanf("%d %d", &pos, &val);

    // Shift elements to the right to create space at position 'pos'
    for (int i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    // Insert the new element
    arr[pos] = val;
    n++; // Increase size of array

    // Print the updated array
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
