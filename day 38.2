/*
Q76: Check if a matrix is symmetric.
*/
#include <iostream>
#include <vector>

using namespace std;

bool isSymmetric(const vector<vector<int>>& matrix) {
    int n = matrix.size();
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            // A matrix is symmetric if element at (i, j) equals element at (j, i)
            if (matrix[i][j] != matrix[j][i]) {
                return false;
            }
        }
    }
    return true;
}

int main() {
    int rows, cols;
    if (!(cin >> rows >> cols)) return 0;

    vector<vector<int>> matrix(rows, vector<int>(cols));
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cin >> matrix[i][j];
        }
    }

    if (rows != cols) {
        // A non-square matrix cannot be symmetric
        cout << "False" << endl;
    } else if (isSymmetric(matrix)) {
        cout << "True" << endl;
    } else {
        cout << "False" << endl;
    }

    return 0;
}
