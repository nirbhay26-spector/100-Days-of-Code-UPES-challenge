// Q96: Reverse each word in a sentence without changing the word order.

#include <stdio.h>
#include <string.h>

void reverseString(char str[], int start, int end) {
    while (start < end) {
        char temp = str[start];
        str[start] = str[end];
        str[end] = temp;
        start++;
        end--;
    }
}

int main() {
    char str[500];

    if (fgets(str, sizeof(str), stdin) != NULL) {
        // Remove trailing newline if present
        str[strcspn(str, "\n")] = '\0';

        int start = 0;
        int len = strlen(str);

        for (int i = 0; i <= len; i++) {
            if (str[i] == ' ' || str[i] == '\0') {
                reverseString(str, start, i - 1);
                start = i + 1;
            }
        }

        printf("%s\n", str);
    }

    return 0;
}
