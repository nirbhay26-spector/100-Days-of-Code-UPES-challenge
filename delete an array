// Q68: Delete an element from an array.


#include <stdio.h>

int main() {
    int n, pos;

    // Read size of array
    if (scanf("%d", &n) != 1) return 0;

    int arr[100]; // Assuming maximum array size

    // Read array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Read target index to delete (0-based index)
    scanf("%d", &pos);

    // Shift elements to the left to overwrite the element at position 'pos'
    for (int i = pos; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }

    n--; // Decrease size of array

    // Print the updated array
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
