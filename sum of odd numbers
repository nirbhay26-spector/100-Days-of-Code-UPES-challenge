Q27: Write a program to print the sum of the first n odd numbers.
#include <stdio.h>

int main() {
    int n, i, num = 1, sum = 0;

    printf("Enter n: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        sum = sum + num;   
        num = num + 2;    
        }

    printf("%d\n", sum);

    return 0;
}
