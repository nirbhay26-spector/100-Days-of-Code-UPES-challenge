// Q94: Find the longest word in a sentence.

#include <stdio.h>
#include <string.h>

int main() {
    char str[500];
    char maxWord[100] = "", currentWord[100] = "";
    int i = 0, j = 0, maxLen = 0;

    if (fgets(str, sizeof(str), stdin) != NULL) {
        // Remove trailing newline if present
        str[strcspn(str, "\n")] = '\0';

        while (1) {
            if (str[i] != ' ' && str[i] != '\0') {
                currentWord[j++] = str[i];
            } else {
                currentWord[j] = '\0';
                if (j > maxLen) {
                    maxLen = j;
                    strcpy(maxWord, currentWord);
                }
                j = 0;
            }

            if (str[i] == '\0') {
                break;
            }
            i++;
        }

        printf("%s\n", maxWord);
    }

    return 0;
}
