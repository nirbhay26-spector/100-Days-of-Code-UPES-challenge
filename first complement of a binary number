//Q40: Write a program to find the 1’s complement of a binary number and print it.
#include <stdio.h>

int main() {
    long num, temp, remainder, complement = 0, place = 1;

    printf("Enter a binary number: ");
    scanf("%ld", &num);

    temp = num;

    while (temp != 0) {
        remainder = temp % 10;

        if (remainder == 0)
            complement = complement + 1 * place;
        else
            complement = complement + 0 * place;

        place = place * 10;
        temp = temp / 10;
    }

    printf("%ld\n", complement);

    return 0;
}
