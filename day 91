// Q141: Define a structure Student with name, roll_no, and marks, then read and print one student's data.

#include <stdio.h>

struct Student {
    char name[50];
    int roll_no;
    float marks;
};

int main() {
    struct Student s;
    
    printf("Enter Name: ");
    scanf("%49s", s.name);
    
    printf("Enter Roll: ");
    scanf("%d", &s.roll_no);
    
    printf("Enter Marks: ");
    scanf("%f", &s.marks);
    
    // Printing output matching the expected format
    // Checking if marks is a whole number to match sample test case formatting if applicable
    if (s.marks == (int)s.marks) {
        printf("Name: %s | Roll: %d | Marks: %d\n", s.name, s.roll_no, (int)s.marks);
    } else {
        printf("Name: %s | Roll: %d | Marks: %.2f\n", s.name, s.roll_no, s.marks);
    }
    
    return 0;
}
