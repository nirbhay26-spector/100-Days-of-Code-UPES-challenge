/*
Q75: Add two matrices.
*/
#include <iostream>
#include <vector>

using namespace std;

int main() {
    int r1, c1;
    if (!(cin >> r1 >> c1)) return 0;

    vector<vector<int>> mat1(r1, vector<int>(c1));
    for (int i = 0; i < r1; ++i) {
        for (int j = 0; j < c1; ++j) {
            cin >> mat1[i][j];
        }
    }

    int r2, c2;
    if (!(cin >> r2 >> c2)) return 0;

    vector<vector<int>> mat2(r2, vector<int>(c2));
    for (int i = 0; i < r2; ++i) {
        for (int j = 0; j < c2; ++j) {
            cin >> mat2[i][j];
        }
    }

    // Add matrices and print the result
    for (int i = 0; i < r1; ++i) {
        for (int j = 0; j < c1; ++j) {
            cout << mat1[i][j] + mat2[i][j] << (j == c1 - 1 ? "" : " ");
        }
        cout << endl;
    }

    return 0;
}
