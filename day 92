// Q142: Store details of 5 students in an array of structures and print all.

#include <stdio.h>

struct Student {
    char name[50];
    int roll;
    float marks;
};

int main() {
    struct Student students[5];
    
    printf("Enter details for 5 students (Name, Roll, Marks):\n");
    for (int i = 0; i < 5; i++) {
        printf("\nStudent %d:\n", i + 1);
        printf("Name: ");
        scanf("%49s", students[i].name);
        printf("Roll: ");
        scanf("%d", &students[i].roll);
        printf("Marks: ");
        scanf("%f", &students[i].marks);
    }
    
    printf("\n--- Tabular List of Students ---\n");
    printf("%-20s %-10s %-10s\n", "Name", "Roll", "Marks");
    printf("----------------------------------------\n");
    
    for (int i = 0; i < 5; i++) {
        if (students[i].marks == (int)students[i].marks) {
            printf("%-20s %-10d %-10d\n", students[i].name, students[i].roll, (int)students[i].marks);
        } else {
            printf("%-20s %-10d %-10.2f\n", students[i].name, students[i].roll, students[i].marks);
        }
    }
    
    return 0;
}
