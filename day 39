// Q77: Check if the elements on the diagonal of a matrix are distinct.
#include <iostream>
#include <vector>
#include <unordered_set>

using namespace std;

bool areDiagonalElementsDistinct(const vector<vector<int>>& matrix) {
    unordered_set<int> seen;
    int n = matrix.size();
    
    for (int i = 0; i < n; ++i) {
        int val = matrix[i][i];
        // If the element is already in the set, it's a duplicate
        if (seen.count(val)) {
            return false;
        }
        seen.insert(val);
    }
    return true;
}

int main() {
    int rows, cols;
    if (!(cin >> rows >> cols)) return 0;

    vector<vector<int>> matrix(rows, vector<int>(cols));
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cin >> matrix[i][j];
        }
    }

    if (areDiagonalElementsDistinct(matrix)) {
        cout << "True" << endl;
    } else {
        cout << "False" << endl;
    }

    return 0;
}
