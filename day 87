// Q137: Create an enum for user roles (ADMIN, USER, GUEST) and display messages based on role.

#include <stdio.h>
#include <string.h>

enum Role {
    ADMIN,
    USER,
    GUEST
};

int main() {
    char input[20];
    
    printf("Enter user role (ADMIN, USER, GUEST): ");
    if (scanf("%19s", input) != 1) {
        return 1;
    }
    
    enum Role current_role;
    
    if (strcmp(input, "ADMIN") == 0 || strcmp(input, "admin") == 0) {
        current_role = ADMIN;
    } else if (strcmp(input, "USER") == 0 || strcmp(input, "user") == 0) {
        current_role = USER;
    } else if (strcmp(input, "GUEST") == 0 || strcmp(input, "guest") == 0) {
        current_role = GUEST;
    } else {
        printf("Invalid role!\n");
        return 1;
    }
    
    switch (current_role) {
        case ADMIN:
            printf("Welcome Admin!\n");
            break;
        case USER:
            printf("Welcome User!\n");
            break;
        case GUEST:
            printf("Welcome Guest!\n");
            break;
    }
    
    return 0;
}
