//Q49: Write a program to print the following pattern:
//5
//45
//345
//2345
//12345

#include <stdio.h>

int main() {
    int n, i, j, start;

    printf("Enter number of rows: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        start = n - i + 1;
        for (j = start; j <= n; j++) {
            printf("%d", j);
        }
        printf("\n");
    }

    return 0;
}
