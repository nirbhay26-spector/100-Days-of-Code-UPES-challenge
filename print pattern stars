//Q50: Write a program to print the following pattern:
//*****
// ****
//***
//   **
//    *

#include <stdio.h>

int main() {
    int n, i, j, space, stars;

    printf("Enter number of rows: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        // print spaces first
        for (space = 1; space <= i - 1; space++)
            printf(" ");

        // print stars
        stars = n - i + 1;
        for (j = 1; j <= stars; j++)
            printf("*");

        printf("\n");
    }

    return 0;
}
