// Q79: Perform diagonal traversal of a matrix.
#include <iostream>
#include <vector>

using namespace std;

vector<int> findDiagonalOrder(vector<vector<int>>& matrix) {
    if (matrix.empty() || matrix[0].empty()) return {};

    int rows = matrix.size();
    int cols = matrix[0].size();
    vector<int> result;
    
    int r = 0, c = 0;
    bool goingUp = true;

    for (int i = 0; i < rows * cols; ++i) {
        result.push_back(matrix[r][c]);

        if (goingUp) {
            if (c == cols - 1) {
                r++;
                goingUp = false;
            } else if (r == 0) {
                c++;
                goingUp = false;
            } else {
                r--;
                c++;
            }
        } else {
            if (r == rows - 1) {
                c++;
                goingUp = true;
            } else if (c == 0) {
                r++;
                goingUp = true;
            } else {
                r++;
                c--;
            }
        }
    }

    return result;
}

int main() {
    int rows = 3, cols = 3;
    vector<vector<int>> matrix = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    vector<int> result = findDiagonalOrder(matrix);

    cout << "Output: ";
    for (int val : result) {
        cout << val << " ";
    }
    cout << endl;

    return 0;
}
