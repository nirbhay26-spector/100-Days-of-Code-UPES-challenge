// Q69: Find the second largest element in an array.


#include <stdio.h>
#include <limits.h>

int main() {
    int n;

    // Read size of array
    if (scanf("%d", &n) != 1 || n < 2) return 0;

    int arr[100]; // Assuming maximum array size

    // Read array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int largest = INT_MIN;
    int second_largest = INT_MIN;

    // Traversal to find the largest and second largest elements
    for (int i = 0; i < n; i++) {
        if (arr[i] > largest) {
            second_largest = largest;
            largest = arr[i];
        } else if (arr[i] > second_largest && arr[i] != largest) {
            second_largest = arr[i];
        }
    }

    // Print the second largest element if it exists
    if (second_largest == INT_MIN) {
        printf("No second largest element\n");
    } else {
        printf("%d\n", second_largest);
    }

    return 0;
}
