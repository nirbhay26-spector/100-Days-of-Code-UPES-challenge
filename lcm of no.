//Q37: Write a program to find the LCM of two numbers.
#include <stdio.h>

int main() {
    int a, b, temp1, temp2, gcd, lcm;

    scanf("%d %d", &a, &b);

    temp1 = a;
    temp2 = b;

    // Find GCD using Euclidean Algorithm
    while (temp2 != 0) {
        int rem = temp1 % temp2;
        temp1 = temp2;
        temp2 = rem;
    }

    gcd = temp1;

    // Find LCM
    lcm = (a * b) / gcd;

    printf("%d", lcm);

    return 0;
}
