// Q119: Write a program to take an integer array as input. Only one element will be printed. Print the repeated element. Try to find the result in one single iteration.

#include <stdio.h>

int main() {
    int n;
    
    printf("Enter the size of the array: ");
    scanf("%d", &n);
    
    int nums[n];
    printf("Enter the elements of the array: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }
    
    int max_val = 0;
    for (int i = 0; i < n; i++) {
        if (nums[i] > max_val) {
            max_val = nums[i];
        }
    }
    
    int freq[max_val + 1];
    for (int i = 0; i <= max_val; i++) {
        freq[i] = 0;
    }
    
    int repeated = -1;
    for (int i = 0; i < n; i++) {
        if (freq[nums[i]] == 1) {
            repeated = nums[i];
            break;
        }
        freq[nums[i]]++;
    }
    
    printf("The repeated element is: %d\n", repeated);
    
    return 0;
}
