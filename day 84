// Q134: Define an enum with SUCCESS, FAILURE, and TIMEOUT, and print messages accordingly.

#include <stdio.h>
#include <string.h>

enum Status {
    SUCCESS,
    FAILURE,
    TIMEOUT
};

int main() {
    char input[20];
    
    printf("Enter status (SUCCESS, FAILURE, TIMEOUT): ");
    if (scanf("%19s", input) != 1) {
        return 1;
    }
    
    enum Status current_status;
    
    if (strcmp(input, "SUCCESS") == 0 || strcmp(input, "success") == 0) {
        current_status = SUCCESS;
    } else if (strcmp(input, "FAILURE") == 0 || strcmp(input, "failure") == 0) {
        current_status = FAILURE;
    } else if (strcmp(input, "TIMEOUT") == 0 || strcmp(input, "timeout") == 0) {
        current_status = TIMEOUT;
    } else {
        printf("Invalid status input!\n");
        return 1;
    }
    
    switch (current_status) {
        case SUCCESS:
            printf("Operation successful\n");
            break;
        case FAILURE:
            printf("Operation failed\n");
            break;
        case TIMEOUT:
            printf("Operation timed out\n");
            break;
    }
    
    return 0;
}
