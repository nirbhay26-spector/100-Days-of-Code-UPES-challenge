Q64: Find the digit that occurs the most times in an integer number.
#include <stdio.h>

int main() {
    long num;
    int digit, i, maxCount = -1, maxDigit = 0;
    int count[10] = {0};   // 10 boxes, all start at 0

    printf("Enter a number: ");
    scanf("%ld", &num);

    while (num != 0) {
        digit = num % 10;
        count[digit]++;
        num = num / 10;
    }

    for (i = 0; i <= 9; i++) {
        if (count[i] > maxCount) {
            maxCount = count[i];
            maxDigit = i;
        }
    }

    printf("%d\n", maxDigit);

    return 0;
}
